# Cloud Run proxy that reads/writes organizer.json in GCS. Not secret (CORS: *,
# access is gated by Firebase Auth + the backend's own allowlist, not by hiding this URL).
VITE_API_BASE_URL=https://your-worker.run.app

# Firebase Web SDK config, from Firebase Console → Project settings → Your apps.
# These are public identifiers, not secrets — safe to commit (see docs/frontend_building
# migration plan, §2). Actual access control happens in the Cloud Run backend's allowlist.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
